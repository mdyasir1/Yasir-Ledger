# ─────────────────────────────────────────────────────────────
# Yasir Ledger — environment variable names
# Copy to `.env.local` and fill in the real values. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Runtime database connection — Supabase transaction-mode pooler (port 6543).
# `pgbouncer=true` is required for the transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct connection — Supabase session-mode pooler (port 5432).
# Used by the Prisma CLI and by the migration runner.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# The single administrator account. Used by the login form.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# HMAC key for the signed session cookie. At least 32 random bytes, hex encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional. The application talks to the database through Prisma and does not need
# these. They are used by `npm run db:check` to prove that the project's publishable
# key is denied by Row Level Security. The publishable key is public by design.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
