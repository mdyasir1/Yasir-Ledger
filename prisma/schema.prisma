// Yasir Ledger — data model
// Source of truth for the typed query client. The database schema itself is created and
// version-controlled as SQL in `supabase/migrations/` (see docs/YASIR_LEDGER_PLAN.md §7.10).
//
// All monetary columns are integer PAISE in a BIGINT column. Rs 1,00,000 = 10000000.
// Money is never stored as floating point.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoundStatus {
  open
  closed
}

enum PaymentMethod {
  upi
  bank_transfer
  cash
  other
}

enum PayoutStatus {
  planned
  paid
  cancelled
}

model Member {
  id                        String   @id @default(uuid()) @db.Uuid
  /// Stable, immutable lookup key used by the idempotent seed script.
  slug                      String   @unique
  fullName                  String   @map("full_name")
  phoneNumber               String?  @map("phone_number")
  /// Default monthly contribution, in paise.
  defaultContributionAmount BigInt   @map("default_contribution_amount")
  isActive                  Boolean  @default(true) @map("is_active")
  notes                     String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  obligations       ContributionObligation[]
  payments          Payment[]
  payouts           Payout[]
  shareGroupMembers ShareGroupMember[]

  @@map("members")
}

model MonthlyRound {
  id               String      @id @default(uuid()) @db.Uuid
  year             Int
  month            Int
  roundName        String      @map("round_name")
  /// Monthly collection target, in paise.
  collectionTarget BigInt      @map("collection_target")
  status           RoundStatus @default(open)
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  obligations       ContributionObligation[]
  payments          Payment[]
  payouts           Payout[]
  shareGroupFrom    ShareGroupMember[] @relation("ShareGroupFrom")
  shareGroupUntil   ShareGroupMember[] @relation("ShareGroupUntil")

  @@unique([year, month], map: "monthly_rounds_year_month_key")
  @@map("monthly_rounds")
}

model ContributionObligation {
  id             String   @id @default(uuid()) @db.Uuid
  roundId        String   @map("round_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  /// Expected contribution for this round, in paise.
  expectedAmount BigInt   @map("expected_amount")
  isApplicable   Boolean  @default(true) @map("is_applicable")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  round  MonthlyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([roundId, memberId], map: "contribution_obligations_round_member_key")
  @@index([memberId])
  @@map("contribution_obligations")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  roundId              String        @map("round_id") @db.Uuid
  memberId             String        @map("member_id") @db.Uuid
  /// Amount received, in paise. Always strictly positive.
  amount               BigInt
  paymentMethod        PaymentMethod @map("payment_method")
  receivedAt           DateTime      @map("received_at")
  transactionReference String?       @map("transaction_reference")
  note                 String?
  /// Client-supplied key that makes a repeated submission a no-op.
  idempotencyKey       String        @unique @map("idempotency_key")
  createdBy            String        @map("created_by") @db.Uuid
  /// Set when this row reverses an earlier payment.
  reversalOfPaymentId  String?       @map("reversal_of_payment_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")

  round      MonthlyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// This row reverses the payment it points at.
  reversalOf Payment?     @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: SetNull)
  /// Rows that reverse this payment.
  reversedBy Payment[]    @relation("PaymentReversal")

  @@index([roundId, memberId])
  @@index([memberId])
  @@index([receivedAt])
  @@map("payments")
}

model Payout {
  id                   String       @id @default(uuid()) @db.Uuid
  roundId              String       @map("round_id") @db.Uuid
  recipientMemberId    String       @map("recipient_member_id") @db.Uuid
  /// Planned disbursement, in paise. Stored independently of any contribution amount.
  plannedAmount        BigInt       @map("planned_amount")
  /// Confirmed disbursement, in paise. Null until the payout is confirmed.
  actualAmount         BigInt?      @map("actual_amount")
  status               PayoutStatus @default(planned)
  paidAt               DateTime?    @map("paid_at")
  transactionReference String?      @map("transaction_reference")
  note                 String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  round     MonthlyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  recipient Member       @relation(fields: [recipientMemberId], references: [id], onDelete: Cascade)

  @@unique([roundId, recipientMemberId], map: "payouts_round_recipient_key")
  @@index([recipientMemberId])
  @@map("payouts")
}

model ShareGroup {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  /// Target share formed by the group, in paise.
  targetShareAmount BigInt   @map("target_share_amount")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  members ShareGroupMember[]

  @@map("share_groups")
}

model ShareGroupMember {
  id                    String   @id @default(uuid()) @db.Uuid
  shareGroupId          String   @map("share_group_id") @db.Uuid
  memberId              String   @map("member_id") @db.Uuid
  /// This member's portion of the group share, in paise.
  allocatedAmount       BigInt   @map("allocated_amount")
  effectiveFromRoundId  String?  @map("effective_from_round_id") @db.Uuid
  effectiveUntilRoundId String?  @map("effective_until_round_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  shareGroup         ShareGroup    @relation(fields: [shareGroupId], references: [id], onDelete: Cascade)
  member             Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  effectiveFromRound  MonthlyRound? @relation("ShareGroupFrom", fields: [effectiveFromRoundId], references: [id], onDelete: SetNull)
  effectiveUntilRound MonthlyRound? @relation("ShareGroupUntil", fields: [effectiveUntilRoundId], references: [id], onDelete: SetNull)

  @@unique([shareGroupId, memberId], map: "share_group_members_group_member_key")
  @@index([memberId])
  @@map("share_group_members")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
